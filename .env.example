# Shared by the Node proxy and the Python voice worker.
# The proxy also falls back to ~/Desktop/suzanne3d-main/.env for the generation keys.

# ── Generation pipeline ──────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
# REPLICATE_API_TOKEN=your-replicate-token   # (REPLICATE_API_KEY also accepted)
# PORT=8787

# ── Voice layer ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...        # LLM router (claude-haiku-4-5)
# DEEPGRAM_API_KEY=...                # streaming STT
# MINIMAX_API_KEY=...                 # streaming TTS  (no group id needed)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# VOICE_ROOM=studio
