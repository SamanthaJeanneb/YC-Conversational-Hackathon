# Shared by the Node proxy and the Python voice worker.
# The proxy also falls back to ~/Desktop/suzanne3d-main/.env for the generation keys.

# ── Generation pipeline ──────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
# REPLICATE_API_TOKEN=your-replicate-token   # (REPLICATE_API_KEY also accepted) — Hunyuan, primary mesh provider
# TRIPO_API_KEY=your-tripo-api-key           # Tripo3D, used as fallback when Hunyuan fails
# TRIPO_FACE_LIMIT=20000                     # optional; TRIPO_TEXTURE_QUALITY=standard|detailed
# PORT=8787

# ── Voice layer (STT/LLM/TTS all via LiveKit Inference — only these needed) ──
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# VOICE_ROOM=studio
