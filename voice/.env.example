# The worker loads the project-root ../.env first (so it shares keys with the
# Node proxy), then this voice/.env if present (overrides). You normally only
# need the root .env — this file is optional.
#
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPGRAM_API_KEY=...
# MINIMAX_API_KEY=...
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
